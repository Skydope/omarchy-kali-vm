#!/bin/bash
set -euo pipefail

# Resolve lib/ directory across multiple install layouts:
#   - AUR:         /usr/bin/omarchy-kali-vm -> /usr/share/omarchy-kali-vm/lib/
#   - make install: /usr/local/bin/...       -> /usr/local/share/omarchy-kali-vm/lib/
#   - repo clone:   ./bin/omarchy-kali-vm    -> ./lib/
SELF_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
for cand in \
  "${OMARCHY_KALI_VM_DATA_DIR:+$OMARCHY_KALI_VM_DATA_DIR/lib}" \
  "$SELF_DIR/../share/omarchy-kali-vm/lib" \
  "$SELF_DIR/../lib"; do
  [[ -n "$cand" && -d "$cand" ]] && { LIBDIR="$cand"; break; }
done

if [[ -z "${LIBDIR:-}" ]]; then
  echo "FATAL: Could not find lib/ directory" >&2
  exit 1
fi

source "$LIBDIR/config.sh"
source "$LIBDIR/debug.sh"
source "$LIBDIR/state.sh"
source "$LIBDIR/ui.sh"
source "$LIBDIR/docker.sh"
source "$LIBDIR/download.sh"
source "$LIBDIR/patch.sh"
source "$LIBDIR/lifecycle.sh"

install_kali() {
  parse_debug_flag install "$@"

  trap "echo ''; echo 'Installation cancelled by user'; exit 1" INT

  if managed_state_exists; then
    print_install_existing_state_error
    exit 1
  fi

  check_install_dependencies
  check_prerequisites

  mkdir -p "$KALI_STORAGE"
  chattr +C "$KALI_STORAGE" 2>/dev/null || true
  mkdir -p "$KALI_CONFIG_DIR"

  TOTAL_RAM=$(free -h | awk 'NR==2 {print $2}')
  TOTAL_RAM_GB=$(awk 'NR==1 {printf "%d", $2/1024/1024}' /proc/meminfo)
  TOTAL_CORES=$(nproc)

  echo ""
  echo "System Resources Detected:"
  echo "  Total RAM: $TOTAL_RAM"
  echo "  Total CPU Cores: $TOTAL_CORES"
  echo ""

  RAM_OPTIONS=""
  for size in 2 4 8 16 32 64; do
    if (( size <= TOTAL_RAM_GB )); then
      RAM_OPTIONS="$RAM_OPTIONS ${size}G"
    fi
  done

  SELECTED_RAM=$(echo $RAM_OPTIONS | tr ' ' '\n' | gum choose --selected="4G" --header="How much RAM would you like to allocate to the Kali VM?")

  if [[ -z $SELECTED_RAM ]]; then
    echo "Installation cancelled by user"
    exit 1
  fi

  SELECTED_CORES=$(gum input --placeholder="Number of CPU cores (1-$TOTAL_CORES)" --value="2" --header="How many CPU cores would you like to allocate to the Kali VM?" --char-limit=2)

  if [[ -z $SELECTED_CORES ]]; then
    echo "Installation cancelled by user"
    exit 1
  fi

  if ! [[ $SELECTED_CORES =~ ^[0-9]+$ ]] || (( SELECTED_CORES < 1 )) || (( SELECTED_CORES > TOTAL_CORES )); then
    echo "Invalid input. Using default: 2 cores"
    SELECTED_CORES=2
  fi

  MIN_DISK_GB=80
  AVAILABLE_SPACE=$(df "$HOME" | awk 'NR==2 {print int($4/1024/1024)}')
  MAX_DISK_GB=$((AVAILABLE_SPACE - 10))

  if (( MAX_DISK_GB < MIN_DISK_GB )); then
    echo "Insufficient disk space for Kali VM!"
    echo "   Available: ${AVAILABLE_SPACE}GB"
    echo "   Minimum required: $((MIN_DISK_GB + 10))GB (${MIN_DISK_GB}GB disk + 10GB overhead)"
    exit 1
  fi

  DISK_OPTIONS=""
  for size in 80 128 256 512; do
    if (( size <= MAX_DISK_GB )); then
      DISK_OPTIONS="$DISK_OPTIONS ${size}G"
    fi
  done

  DEFAULT_DISK="128G"
  if ! echo "$DISK_OPTIONS" | grep -q "128G"; then
    DEFAULT_DISK="80G"
  fi

  SELECTED_DISK=$(echo $DISK_OPTIONS | tr ' ' '\n' | gum choose --selected="$DEFAULT_DISK" --header="Max disk size for the Kali VM? (starts at ~16GB, grows as needed up to this limit)")

  if [[ -z $SELECTED_DISK ]]; then
    echo "Installation cancelled by user"
    exit 1
  fi

  DISK_SIZE_NUM=$(echo "$SELECTED_DISK" | sed 's/G//')

  check_prerequisites "$DISK_SIZE_NUM"

  USERNAME=$(gum input --placeholder="Username (Press enter to use default: kali)" --header="Enter Kali username:")
  if [[ -z $USERNAME ]]; then
    USERNAME="kali"
  fi

  PASSWORD=$(gum input --placeholder="Password (Press enter to use default: kali)" --password --header="Enter Kali password:")
  if [[ -z $PASSWORD ]]; then
    PASSWORD="kali"
    PASSWORD_DISPLAY="(default)"
  else
    PASSWORD_DISPLAY="(user-defined)"
  fi

  gum style \
    --border normal \
    --padding "1 2" \
    --margin "1" \
    --align left \
    --bold \
    "Kali VM Configuration" \
    "" \
    "RAM:       $SELECTED_RAM" \
    "CPU:       $SELECTED_CORES cores" \
    "Disk:      $SELECTED_DISK" \
    "Username:  $USERNAME" \
    "Password:  $PASSWORD_DISPLAY"

  echo ""
  if ! gum confirm "Proceed with this configuration?"; then
    echo "Installation cancelled by user"
    exit 1
  fi

  echo "sudo is required to load the nbd kernel module for initial image configuration."
  echo ""
  sudo -v || exit 1

  mkdir -p "$KALI_SHARED_DIR"

  write_kali_start_hook

  cat << EOF | tee "$COMPOSE_FILE" > /dev/null
services:
  kali:
    image: ${QEMU_IMAGE_DIGEST}
    container_name: ${CONTAINER_NAME}
    environment:
      RAM_SIZE: "$SELECTED_RAM"
      CPU_CORES: "$SELECTED_CORES"
      DISK_SIZE: "$SELECTED_DISK"
      BOOT_MODE: "legacy"
      VGA: "virtio"
      DISPLAY: "disabled"
      WEB: "N"
      ARGUMENTS: "$(kali_qemu_arguments)"
    devices:
      - /dev/kvm
      - /dev/net/tun
    security_opt:
      - "no-new-privileges:true"
    cap_drop:
      - ALL
    cap_add:
      - NET_ADMIN
      - NET_BIND_SERVICE
      - SETGID
      - SETUID
    volumes:
      - $HOME/.kali:/storage
      - $KALI_SHARED_DIR:/shared
      - $KALI_CONFIG_DIR/start.sh:/run/start.sh:ro
    restart: "no"
    stop_grace_period: 2m
EOF

  ensure_kali_runtime_config

  echo ""
  echo "Starting Kali VM installation..."
  echo "This will download a pre-built Kali QCOW2 image (~3GB) and configure it."
  echo "The setup takes 5-15 minutes depending on your internet speed."
  echo ""

  DEBUG_STAGE="download"
  if ! download_kali_qcow2; then
    echo "Failed to download Kali QCOW2 image!"
    exit 1
  fi

  if [[ ! -f "$KALI_STORAGE/.configured" ]]; then
    echo ""
    DEBUG_STAGE="patch"
    if patch_qcow2 "$USERNAME" "$PASSWORD" "$SELECTED_DISK"; then
      touch "$KALI_STORAGE/.configured"
    else
      if [[ "$DEBUG_MODE" = true ]]; then
        fail_install "patch" "Failed to configure Kali image."
      fi
      echo "Failed to configure Kali image."
      echo "You can retry by running: omarchy-kali-vm install"
      exit 1
    fi
  else
    echo "Kali image already configured, skipping."
  fi

  echo ""
  echo "Starting Kali VM..."
  cleanup_stale_data_disk
  DEBUG_STAGE="startup"
  if ! docker compose -f "$COMPOSE_FILE" up -d 2>&1; then
    if [[ "$DEBUG_MODE" = true ]]; then
      fail_install "startup" "Failed to start Kali VM."
    fi
    echo "Failed to start Kali VM!"
    echo "   Common issues:"
    echo "   - Docker daemon not running: sudo systemctl start docker"
    echo "   - KVM not available: check /dev/kvm"
    exit 1
  fi

  local SPICE_SOCK="$KALI_STORAGE/spice.sock"
  echo "Waiting for VM to be ready..."
  local WAIT_COUNT=0
  until [[ -S "$SPICE_SOCK" ]]; do
    sleep 2
    WAIT_COUNT=$((WAIT_COUNT + 1))
    if (( WAIT_COUNT > 60 )); then
      if [[ "$DEBUG_MODE" = true ]]; then
        fail_install "startup" "Timeout waiting for Kali VM SPICE to become ready."
      fi
      echo "Timeout: Kali VM SPICE not ready within 2 minutes"
      exit 1
    fi
  done
  docker exec "$CONTAINER_NAME" chown "$(id -u):$(id -g)" /storage/spice.sock
  docker exec "$CONTAINER_NAME" chmod 660 /storage/spice.sock
  write_runtime_launcher

  if [[ "$DEBUG_MODE" = true ]]; then
    DEBUG_STATUS="succeeded"
    DEBUG_MESSAGE="Install completed successfully."
    write_debug_report
    print_debug_summary
  fi

  echo ""
  echo "Kali VM installed! Launching..."
  echo "Closing the viewer will power down the VM by default."
  echo "The host shared folder ~/Kali will be mounted inside Kali at ~/Kali."
  setsid bash -c "
    remote-viewer 'spice+unix://$SPICE_SOCK' -t 'Kali VM' --auto-resize=always &>/dev/null
    docker exec '$CONTAINER_NAME' bash -c 'echo system_powerdown | nc -q1 localhost 7100' 2>/dev/null || true
    WAIT=0
    while docker inspect --format='{{.State.Status}}' '$CONTAINER_NAME' 2>/dev/null | grep -q running; do
      sleep 2
      WAIT=\$((WAIT + 1))
      (( WAIT > 30 )) && break
    done
    docker compose -f '$COMPOSE_FILE' down 2>/dev/null || true
    rm -f '$SPICE_SOCK'
  " &>/dev/null &
}

remove_kali() {
  parse_debug_flag remove "$@"
  check_remove_dependencies

  print_remove_preview

  if ! gum confirm --default=false "Remove Kali VM and delete all associated data?"; then
    echo "Removal cancelled by user"
    exit 1
  fi

  echo "Removing Kali VM..."
  DEBUG_STAGE="remove"

  best_effort_remove_docker_artifacts

  if [[ "$DEBUG_MODE" = true ]]; then
    preserve_remove_debug_artifacts
  fi

  rm -rf "$KALI_CONFIG_DIR"
  rm -rf "$KALI_STORAGE"
  rm -rf "$KALI_SHARED_DIR"
  remove_runtime_launcher

  if [[ "$DEBUG_MODE" = true ]]; then
    DEBUG_STATUS="succeeded"
    DEBUG_MESSAGE="Remove completed with debug retention enabled."
    write_debug_report
    print_debug_summary
  fi

  echo ""
  echo "Kali VM removal completed!"
}

verify_image() {
  if ! docker_available; then
    echo "Docker is not available. Cannot verify image."
    exit 1
  fi

  echo "Expected image: $QEMU_IMAGE_DIGEST"
  local local_digest
  local_digest=$(docker inspect --format='{{index .RepoDigests 0}}' "${QEMU_IMAGE_DIGEST%%@*}" 2>/dev/null || true)

  if [[ -z "$local_digest" ]]; then
    echo "Image not found locally. Pulling..."
    docker pull "$QEMU_IMAGE_DIGEST" || {
      echo "ERROR: Failed to pull $QEMU_IMAGE_DIGEST"
      exit 1
    }
    local_digest=$(docker inspect --format='{{index .RepoDigests 0}}' "${QEMU_IMAGE_DIGEST%%@*}" 2>/dev/null || true)
  fi

  if [[ "$local_digest" == "$QEMU_IMAGE_DIGEST" ]]; then
    echo "Digest matches. Image integrity verified."
  else
    echo "WARNING: Local digest does not match expected."
    echo "  Local:    ${local_digest:-unknown}"
    echo "  Expected: $QEMU_IMAGE_DIGEST"
    exit 1
  fi
}

case "${1:-}" in
  install)
    shift
    install_kali "$@"
    ;;
  remove)
    shift
    remove_kali "$@"
    ;;
  launch|start)
    launch_kali "${2:-}"
    ;;
  stop|down)
    stop_kali
    ;;
  status)
    status_kali
    ;;
  verify-image)
    verify_image
    ;;
  help|--help|-h|"")
    show_usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo "" >&2
    show_usage >&2
    exit 1
    ;;
esac
